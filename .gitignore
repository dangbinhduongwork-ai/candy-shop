# ==========================================
# Root .gitignore for Candy Shop Monorepo
# ==========================================

# Compiled class files
*.class

# Log files
*.log

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven build directory
target/
**/target/

# Node / Frontend build & dependencies
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.local

# Environment variables
.env
**/.env
!.env.example
!**/.env.example

# Uploaded user media (keep folder clean)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# IDE and Editor files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Scratch and temporary scripts/files
scratch/
**/scratch/
backend/test_*.ps1
*.apk
*.aab
url_crop.png
